<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One legacy bookmark redirect — nothing else for the landing URL
  RewriteRule ^tourism/?$ /destination-marketing-agency/ [R=302,L]

  # Pretty PDF URL
  RewriteRule ^indian-outbound-tourism-report/?$ assets/reports/The\ Indian\ Outbound\ Inspiration\ report\ 2026.pdf [L]

  # Missing /assets/* → real 404 (not SPA html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L]

  # SPA: only if path is not a real file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
