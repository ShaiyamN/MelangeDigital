<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Legacy /tourism/ → report landing slug
  RewriteRule ^tourism/?$ /indian-outbound-tourism-report/ [R=301,L]
  RewriteRule ^tourism/index\.html$ /indian-outbound-tourism-report/ [R=301,L]

  # Report landing: clean URL (not …/index.html)
  RewriteRule ^indian-outbound-tourism-report/index\.html$ /indian-outbound-tourism-report/ [R=301,L]
  RewriteRule ^indian-outbound-tourism-report$ /indian-outbound-tourism-report/ [R=301,L]
  RewriteRule ^indian-outbound-tourism-report/$ - [L]

  # Don't rewrite requests for actual files and directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Serve index.html for all other routes (SPA fallback)
  RewriteRule ^ index.html [QSA,L]
</IfModule>
