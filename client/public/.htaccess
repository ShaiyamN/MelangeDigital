<IfModule mod_headers.c>
  # Stale index.html after deploy → browser requests deleted /assets/*.js → 404
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Tourism landing is SPA home (`/`). Old URLs redirect; assets stay under DMA/.
  DirectorySlash Off
  RewriteRule ^destination-marketing-agency/?$ / [R=301,L]
  RewriteRule ^destination-marketing/?$ / [R=301,L]
  RewriteRule ^tourism/?$ / [R=301,L]

  # Pretty PDF URL
  RewriteRule ^indian-outbound-tourism-report/?$ assets/reports/The\ Indian\ Outbound\ Inspiration\ report\ 2026.pdf [L]

  # Missing /assets/* → real 404 (not SPA html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L]

  # Redirect trailing slashes to non-trailing slash (except root / and directories with index.html)
  RewriteCond %{REQUEST_METHOD} =GET [OR]
  RewriteCond %{REQUEST_METHOD} =HEAD
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ %1 [R=301,L]

  # Real file → serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Real directory with index.html → serve directly
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # SPA fallback (handles routes like /contact, /about, /services)
  RewriteRule ^ index.html [QSA,L]
</IfModule>
