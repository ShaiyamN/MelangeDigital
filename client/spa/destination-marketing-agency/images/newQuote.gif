      height: 44px;
      border: 4px solid rgba(0, 0, 0, .15);
      border-top-color: rgba(0, 0, 0, .65);
      border-radius: 50%;
      animation: bootspin .8s linear infinite;
    }

    @keyframes bootspin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
